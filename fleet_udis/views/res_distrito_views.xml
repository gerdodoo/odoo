<odoo>
    <data>
        <record id="view_res_distrito_form" model="ir.ui.view">
            <field name="name">res.distrito.form</field>
            <field name="model">res.distrito</field>
            <field name="arch" type="xml">
                <form string="Distrito">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_res_distrito_tree" model="ir.ui.view">
            <field name="name">res.distrito.tree</field>
            <field name="model">res.distrito</field>
            <field name="arch" type="xml">
                <tree string="Distrito">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="action_res_distrito" model="ir.actions.act_window">
            <field name="name">Distritos</field>
            <field name="res_model">res.distrito</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_res_distrito_root" name="Distritos"/>
        <menuitem id="menu_res_distrito" name="Registros" parent="menu_res_distrito_root" action="action_res_distrito"/>
    </data>
</odoo>
