<odoo>
    <record id="purchase_order_department_rule" model="ir.rule">
        <field name="name">Purchase Orders by Department</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">
            ['|', ('department_id', 'in', user.allowed_department_ids.ids), ('user_has_group', 'purchase.group_purchase_manager')]
        </field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
</odoo>
