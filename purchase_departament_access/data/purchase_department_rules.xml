<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="purchase_department_rule_user" model="ir.rule">
            <field name="name">Purchase Department: User Access</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
            <field name="domain_force">[('department_id.manager_id.user_id', '=', user.id)]</field>
        </record>

        <record id="purchase_department_rule_manager" model="ir.rule">
            <field name="name">Purchase Department: Manager Access</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
            <field name="domain_force">[]</field>
        </record>
    </data>
</odoo>
