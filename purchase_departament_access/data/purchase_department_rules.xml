<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Regla para usuarios de compras: solo pueden ver órdenes de sus departamentos permitidos -->
    <record id="purchase_order_department_rule_user" model="ir.rule">
        <field name="name">Purchase Orders by Department</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[('department_id', 'in', user.allowed_department_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <!-- Regla para gerentes de compras: acceso total a todas las órdenes -->
    <record id="purchase_order_department_rule_manager" model="ir.rule">
        <field name="name">Purchase Orders - Manager Access</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
    </record>
</odoo>
