<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Acción de Ventana -->
        <record id="action_purchase_request" model="ir.actions.act_window">
            <field name="name">Solicitudes de Compra</field>
            <field name="res_model">purchase.request</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="purchase_request_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea tu primera solicitud de compra
                </p>
            </field>
        </record>

        <!-- Menú Principal -->
        <menuitem
            id="menu_purchase_request_root"
            name="Solicitudes de Compra"
            sequence="25"
            web_icon="purchase,static/description/icon.png"
            groups="base.group_user"/>

        <!-- Submenú -->
        <menuitem
            id="menu_purchase_request_main"
            name="Solicitudes de Compra"
            parent="menu_purchase_request_root"
            action="action_purchase_request"
            sequence="10"/>

    </data>
</odoo>
