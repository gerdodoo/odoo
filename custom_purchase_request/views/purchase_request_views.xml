        <!-- Vista de Formulario (Form) -->
        <record id="purchase_request_form_view" model="ir.ui.view">
            <field name="name">purchase.request.form</field>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <form string="Solicitud de Compra">
<header>
    <!-- Botón para enviar a aprobación, visible solo en estado Borrador -->
    <button name="action_submit"
            string="Enviar a Aprobación"
            type="object"
            class="oe_highlight"
            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
    
    <!-- Botones para el Gerente de Compras, visibles solo en estado Para Aprobar -->
    <button name="action_approve"
            string="Aprobar"
            type="object"
            class="oe_highlight"
            attrs="{'invisible': [('state', '!=', 'to_approve')]}"
            groups="purchase.group_purchase_manager"/>
    <button name="action_reject"
            string="Rechazar"
            type="object"
            attrs="{'invisible': [('state', '!=', 'to_approve')]}"
            groups="purchase.group_purchase_manager"/>
    
    <!-- Botón para restablecer a borrador, visible para el Gerente en estados finales -->
    <button name="action_set_to_draft"
            string="Restablecer a Borrador"
            type="object"
            attrs="{'invisible': [('state', 'not in', ['approved', 'rejected'])]}"
            groups="purchase.group_purchase_manager"/>

    <!-- La barra de estado -->
    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved,done"/>
</header>
                    <sheet>
                        <!-- ... (el resto de tu sheet se mantiene igual: oe_title, group, notebook, etc.) ... -->
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="requester_id"/>
                                <field name="department_id"/>
                            </group>
                            <group>
                                <field name="request_date"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Líneas de Solicitud" name="request_lines">
                                <field name="request_line_ids">
                                    <tree editable="bottom">
                                        <field name="product_id"/>
                                        <field name="description"/>
                                        <field name="quantity"/>
                                        <field name="product_uom_id" string="UdM"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
