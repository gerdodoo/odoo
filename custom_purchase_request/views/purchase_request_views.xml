<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista de Formulario (Form) -->
        <record id="purchase_request_form_view" model="ir.ui.view">
            <field name="name">purchase.request.form</field>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <form string="Solicitud de Compra">
                    <header>
                        <!-- Aquí puedes añadir botones para el flujo de aprobación -->
                        <field name="state" widget="statusbar" statusbar_visible="draft,approved,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="requester_id"/>
                                <field name="department_id"/>
                            </group>
                            <group>
                                <field name="request_date"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Líneas de Solicitud" name="request_lines">
                                <field name="request_line_ids">
                                    <tree editable="bottom">
                                        <field name="product_id"/>
                                        <field name="description"/>
                                        <field name="quantity"/>
                                        <field name="product_uom_id" string="UdM"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Vista de Árbol (Tree) -->
        <record id="purchase_request_tree_view" model="ir.ui.view">
            <field name="name">purchase.request.tree</field>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <tree string="Solicitudes de Compra">
                    <field name="name"/>
                    <field name="requester_id"/>
                    <field name="department_id"/>
                    <field name="request_date"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- Vista de Búsqueda (Search) -->
        <record id="purchase_request_search_view" model="ir.ui.view">
            <field name="name">purchase.request.search</field>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <search string="Buscar Solicitudes de Compra">
                    <field name="name"/>
                    <field name="requester_id"/>
                    <field name="department_id"/>
                    <separator/>
                    <filter string="Mis Solicitudes" name="my_requests" domain="[('requester_id', '=', uid)]"/>
                    <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Solicitante" name="group_by_requester" context="{'group_by': 'requester_id'}"/>
                        <filter string="Departamento" name="group_by_department" context="{'group_by': 'department_id'}"/>
                        <filter string="Estado" name="group_by_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>